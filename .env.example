# Copy this file to ".env" and fill in your real values.
# Never commit your real .env file.

# --- Twitter / X API credentials (required to post tweets) ---
TWITTER_API_KEY=your_key_here
TWITTER_API_SECRET=your_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# --- Optional extras ---
WEATHER_API_KEY=optional_weather_api_key_here
VISION_AI_API_KEY=optional_vision_ai_key_here

# Turn AI visual judgement on/off. Default is false (image comparison only).
ENABLE_AI_JUDGEMENT=false

# When true, the bot will NOT post real tweets. It only prints what it would tweet.
# Great for testing. Set to false when you want it to post for real.
DRY_RUN=true
